<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and configs tying voice_node, gesture_node, motor_driver, slam_toolbox, twist_mux and Nav2 together</description>
  <maintainer email="dev@example.com">gremlin team</maintainer>
  <license>MIT</license>

  <exec_depend>voice_node</exec_depend>
  <exec_depend>gesture_node</exec_depend>
  <exec_depend>motor_driver</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
